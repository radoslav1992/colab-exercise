# Cloudflare static assets: headers for every response.
#
# The Content-Security-Policy is the second line of defence behind the sanitizer (notebooks are
# untrusted input): no inline scripts, scripts only from this site and the jsDelivr CDN.
#   script-src   'wasm-unsafe-eval' lets Pyodide and the model runtimes compile WebAssembly;
#                cdn.jsdelivr.net serves Pyodide, Transformers.js and the Hugging Face client;
#                blob: is for the ONNX runtime, which may import its glue code from a blob.
#   connect-src  any https address: Python packages, model files (huggingface.co and its storage
#                hosts) and whatever a student's own code fetches.
# Cross-origin isolation (COOP/COEP) is deliberately not set; see the README.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: data: blob:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
/assets/*
  Cache-Control: public, max-age=31536000, immutable
