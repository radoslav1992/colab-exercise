# Used by `npm run build:e2e` only: everything loads from this server, nothing from a CDN.
# Pyodide comes from node_modules/pyodide; the model libraries are the stubs in tests/stubs.
VITE_PYODIDE_INDEX_URL=/pyodide/
VITE_TRANSFORMERS_URL=/stubs/transformers.js
VITE_HF_INFERENCE_URL=/stubs/inference.js
