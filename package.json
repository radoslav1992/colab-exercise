{
  "name": "colab-exercise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype: course notebooks that run in the student's browser (Pyodide + WebGPU models).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:python",
    "test:watch": "vitest",
    "test:python": "python3 -m unittest discover -s tests/python",
    "test:e2e": "npm run build:e2e && node tests/e2e/run.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.5.0",
    "katex": "^0.19.1",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "jsdom": "^31.0.1",
    "pyodide": "314.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
