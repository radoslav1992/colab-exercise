{
  "name": "colab-exercise",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Course notebooks that run in the student's browser (Pyodide + WebGPU models), with accounts, courses, assignments and submissions.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/dev.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "start:local": "npm run build && node --disable-warning=ExperimentalWarning server/dev.ts --site",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:python",
    "test:watch": "vitest",
    "test:python": "python3 -m unittest discover -s tests/python",
    "test:e2e": "npm run build:e2e && node --disable-warning=ExperimentalWarning tests/e2e/run.mjs",
    "db:migrate:local": "wrangler d1 migrations apply colab-exercise --local",
    "db:migrate:remote": "wrangler d1 migrations apply colab-exercise --remote",
    "reset-link": "node scripts/reset-link.ts",
    "doodles": "node scripts/doodles.mjs",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@hono/node-server": "^2.1.11",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.5.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.22",
    "katex": "^0.19.1",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@types/node": "^22.20.7",
    "jsdom": "^31.0.1",
    "pyodide": "314.0.8",
    "roughjs": "^4.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
